# Personal settings for the scripts in scripts/ios (see AppStore.md).
# `npm run ios:doctor` copies this to ios/local.env (git-ignored) and fills in
# what it can detect. Environment variables with the same name win over this file.

# Your Apple team ID (10 characters). With a free Apple ID this is your
# "Personal Team"; ios:doctor reads it from Xcode once you have signed in there.
IOS_TEAM_ID=

# Bundle identifier. It has to be unique across all Apple developers. If Xcode
# says it "is not available", pick your own, e.g. com.yourname.tensaiasobi.
IOS_BUNDLE_ID=com.tensaiasobi.app

# Optional: which iPhone/iPad to deploy to (name or UDID) when several are paired.
IOS_DEVICE=

# Optional: simulator name for `npm run ios:sim`, e.g. "iPhone 17".
IOS_SIMULATOR=
