{
  "name": "tensaiasobi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "npm run lint && vite build",
    "build:ios": "npm run lint && vite build --mode ios",
    "lint:eslint": "eslint .",
    "lint:ts": "tsc --build",
    "lint": "npm run lint:eslint && npm run lint:ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ios:doctor": "bash scripts/ios/doctor.sh",
    "ios:sync": "bash scripts/ios/sync.sh",
    "ios:open": "bash scripts/ios/sync.sh && cap open ios",
    "ios:sim": "bash scripts/ios/run-simulator.sh",
    "ios:device": "bash scripts/ios/deploy-device.sh",
    "ios:ipa": "bash scripts/ios/build-ipa.sh",
    "ios:auto-refresh": "bash scripts/ios/auto-refresh.sh",
    "ios:assets": "capacitor-assets generate --ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.6.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
